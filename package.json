{
  "name": "vue-playlist-converter",
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "npm --prefix server test",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src server --max-warnings 0",
    "lint:fix": "eslint src server --fix",
    "format": "prettier --write src server/*.js server/*.cjs server/test",
    "format:check": "prettier --check src server/*.js server/*.cjs server/test"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
